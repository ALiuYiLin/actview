{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "jsxImportSource": "@actview/jsx",
    "paths": {
      "@actview/runtime-core": ["../runtime-core/src/index.ts"],
      "@actview/runtime-core/*": ["../runtime-core/src/*"],
      "@actview/jsx": ["./src/index.ts"],
      "@actview/jsx/*": ["./src/*"]
    }
  },
  "include": ["src", "type-tests"]
}
