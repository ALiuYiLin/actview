{
  // ============================================================
  // @actview/jsx — 类型测试配置（noEmit）
  //
  //   type-tests（TSX 作者层契约）单独于构建配置检查；使用源码 paths
  //   直接检查 @actview/core / reactivity 的公开类型。
  //   reactivity 源码需要 ES2016 + erasableSyntaxOnly:false（上游编译前提）。
  // ============================================================
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "target": "ES2016",
    "lib": ["ES2016", "DOM"],
    "erasableSyntaxOnly": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@actview/jsx",
    "paths": {
      "@actview/core": ["../core/src/index.ts"],
      "@actview/core/*": ["../core/src/*"],
      "@actview/reactivity": ["../reactivity/src/index.ts"],
      "@actview/reactivity/*": ["../reactivity/src/*"],
      "@actview/shared": ["../shared/src/index.ts"],
      "@actview/shared/*": ["../shared/src/*"],
      "@actview/jsx": ["./src/index.ts"],
      "@actview/jsx/*": ["./src/*"]
    }
  },
  "include": ["src", "type-tests", "../global.d.ts"]
}
