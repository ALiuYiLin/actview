{
  "name": "@actview/jsx",
  "version": "0.0.1",
  "type": "module",
  "description": "ActView JSX authoring layer — global JSX namespace, DOM attribute types and JSX runtime",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "dependencies": {
    "@actview/runtime-core": "workspace:^"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b . && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "import": "./dist/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "import": "./dist/jsx-dev-runtime.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actview/actview.git",
    "directory": "packages/jsx"
  },
  "license": "MIT"
}
