{
  "name": "@actview/core",
  "version": "1.5.1",
  "type": "module",
  "description": "ActView DOM runtime public layer — renderer, createApp and built-in components (upcoming)",
  "exports": {
    ".": "./src/index.ts",
    "./server-internal": "./src/server-internal.ts"
  },
  "dependencies": {
    "@actview/reactivity": "workspace:^",
    "@actview/shared": "workspace:^"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b . && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server-internal": {
        "types": "./dist/server-internal.d.ts",
        "import": "./dist/server-internal.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actview/actview.git",
    "directory": "packages/core"
  },
  "license": "MIT"
}
