{
  // ============================================================
  // @actview/compiler — 构建配置（composite project）
  //
  //   src → dist-types/*.d.ts（gitignore）；__tests__ 在 tsconfig.test.json。
  //   src 不 import 任何 @actview 运行时包（编译产物才 import），因此无 references。
  // ============================================================
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],

    /* composite project：只发声明 */
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist-types",
    "rootDir": "src",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo",

    "paths": {}
  },
  "include": ["src"]
}
