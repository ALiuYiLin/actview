{
  "name": "@actview/compiler",
  "version": "0.0.1",
  "type": "module",
  "description": "ActView compiler package — L1 wrap removed; Babel retained for decorator lowering / future analysis",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@babel/core": "^8.0.1"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b . && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/actview/actview.git",
    "directory": "packages/compiler"
  },
  "license": "MIT"
}
