{
  "name": "@actview/runtime-core",
  "version": "0.0.1",
  "type": "module",
  "description": "ActView runtime kernel — public element/component contracts + internal VNode/component types",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b . && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actview/actview.git",
    "directory": "packages/runtime-core"
  },
  "license": "MIT"
}
