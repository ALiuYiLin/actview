{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@actview/jsx",
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist-types",
    "rootDir": "src",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo",
    "paths": {
      "@actview/core": ["../core/src/index.ts"],
      "@actview/core/*": ["../core/src/*"],
      "@actview/jsx": ["../jsx/src/index.ts"],
      "@actview/jsx/*": ["../jsx/src/*"],
      "@actview/reactivity": ["../reactivity/src/index.ts"],
      "@actview/reactivity/*": ["../reactivity/src/*"],
      "@actview/shared": ["../shared/src/index.ts"],
      "@actview/shared/*": ["../shared/src/*"],
      "actview": ["../actview/src/index.ts"]
    }
  },
  "include": [
    "src/client/index.ts",
    "src/client/styles.d.ts",
    "src/client/app/createDocsApp.tsx",
    "src/client/markdown",
    "src/client/theme-default/Layout.tsx",
    "src/client/theme-default/components",
    "src/client/theme-default/composables/data.ts",
    "src/client/theme-default/composables/layout.ts",
    "src/client/theme-default/composables/sidebar.ts",
    "src/client/theme-default/composables/route.ts",
    "src/client/theme-default/composables/nav.ts",
    "src/client/theme-default/composables/langs.ts",
    "src/node/markdownToActview.ts",
    "src/node/actviewPlugin.ts"
  ],
  "references": [
    { "path": "../shared" },
    { "path": "../reactivity" },
    { "path": "../core" },
    { "path": "../jsx" },
    { "path": "../actview" }
  ]
}
