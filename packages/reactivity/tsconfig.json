{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 派生自 Vue 源码：允许 enum 等非可擦除语法；不因上游/测试的未使用变量报错
    "strict": true,
    // 与上游 @vue/reactivity 3.5.39 的 tsconfig 对齐（es2016 lib）：
    // 源码里 @ts-expect-error 依赖 es2016 lib 下"新数组方法不存在"这一前提
    "target": "ES2016",
    "lib": ["ES2016", "DOM"],
    "erasableSyntaxOnly": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@actview/shared": ["../shared/src/index.ts"],
      "@actview/reactivity": ["./src/index.ts"]
    }
  },
  "include": ["src", "__tests__", "vitest.config.ts", "../global.d.ts"]
}
