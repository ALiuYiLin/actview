{
  "manifest_version": 3,
  "name": "ActView DevTools",
  "version": "0.1.0",
  "description": "ActView component tree, state, events and performance inspector",
  "devtools_page": "devtools.html",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
