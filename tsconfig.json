{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@local/jsx-factory",

    /* Path aliases — resolves workspace packages */
    "paths": {
      "@local/jsx-factory": ["./packages/jsx/src/index.ts"],
      "@local/jsx-factory/*": ["./packages/jsx/src/*"],
      "@local/core": ["./packages/core/src/index.ts"],
      "@local/core/*": ["./packages/core/src/*"],
      "@actview/plugin": ["./plugins/plugin/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": ["src", "packages/jsx/src/global.ts", "packages/core"]
}
