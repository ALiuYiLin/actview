{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@actview/jsx",

    /* Path aliases — resolves workspace packages */
    "paths": {
      "@actview/jsx": ["./packages/jsx/src/index.ts"],
      "@actview/jsx/*": ["./packages/jsx/src/*"],
      "@actview/core": ["./packages/core/src/index.ts"],
      "@actview/core/*": ["./packages/core/src/*"],
      "@actview/plugin": ["./plugins/plugin/src/index.ts"],
      "@actview/plugin-scoped": ["./plugins/plugin-scoped/src/index.ts"],
      "@actview/plugin-scoped/*": ["./plugins/plugin-scoped/src/*"],
      "@actview/router": ["./packages/router/src/index.ts"],
      "actview": ["./packages/actview/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": ["src", "packages/jsx/src/global.ts", "packages/core", "packages/router"]
}
