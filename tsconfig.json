{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Allow reading .js files for the JSX factory runtime */
    "allowJs": true,
    "checkJs": false,

    "jsx": "react-jsx",
    "jsxImportSource": "@local/jsx-factory",

    /* Path aliases — resolves @local/jsx-factory to packages/jsx/src */
    "paths": {
      "@local/jsx-factory": ["./packages/jsx/src/index.ts"],
      "@local/jsx-factory/*": ["./packages/jsx/src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": ["src", "packages/jsx/global.d.ts"]
}
