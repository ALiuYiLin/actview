{
  "name": "actview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm -C playground/actview dev",
    "build": "pnpm -C playground/actview build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:extension": "vite build --config extensions/devtools/vite.config.ts",
    "preview": "pnpm -C playground/actview preview",
    "typecheck": "tsc -b tsconfig.json && pnpm -C packages/shared typecheck && pnpm -C packages/reactivity typecheck && pnpm -C packages/core typecheck && pnpm -C packages/devtools typecheck && pnpm -C packages/router typecheck && pnpm -C packages/jsx typecheck && pnpm -C packages/actview typecheck && pnpm -C playground/actview typecheck && tsc -p extensions/devtools/tsconfig.json --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "changeset version && changeset publish"
  },
  "devDependencies": {
    "@actview/core": "workspace:*",
    "@actview/jsx": "workspace:*",
    "@actview/reactivity": "workspace:*",
    "actview": "workspace:*",
    "@babel/core": "^8.0.1",
    "@changesets/cli": "^3.0.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.0.1",
    "happy-dom": "^20.11.1",
    "jsdom": "^27.4.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
