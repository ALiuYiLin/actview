{
  "name": "actview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "pnpm -r publish",
    "release:dry": "pnpm -r publish --dry-run",
    "release:patch": "node scripts/bump.mjs patch && pnpm -r publish",
    "release:minor": "node scripts/bump.mjs minor && pnpm -r publish",
    "release:major": "node scripts/bump.mjs major && pnpm -r publish"
  },
  "devDependencies": {
    "@actview/core": "workspace:*",
    "@actview/jsx": "workspace:*",
    "@actview/plugin-babel": "workspace:*",
    "@actview/plugin-scoped": "workspace:*",
    "@actview/plugin-vite": "workspace:*",
    "@actview/router": "workspace:*",
    "@actview/store": "workspace:*",
    "@actview/testing": "workspace:*",
    "@actview/devtools": "workspace:*",
    "@types/node": "^26.0.1",
    "actview": "workspace:*",
    "@babel/core": "^8.0.1",
    "happy-dom": "^20.11.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
