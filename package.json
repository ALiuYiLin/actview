{
  "name": "actview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "pnpm -r publish",
    "release:dry": "pnpm -r publish --dry-run",
    "patch:actview": "cd packages/actview && npm version patch",
    "patch:jsx": "cd packages/jsx && npm version patch",
    "patch:core": "cd packages/core && npm version patch",
    "patch:vite": "cd plugins/vite && npm version patch",
    "patch:babel": "cd plugins/babel && npm version patch",
    "patch:scoped": "cd plugins/scoped && npm version patch",
    "patch:router": "cd packages/router && npm version patch"
  },
  "devDependencies": {
    "@actview/core": "workspace:*",
    "@actview/jsx": "workspace:*",
    "@actview/plugin-babel": "workspace:*",
    "@actview/plugin-scoped": "workspace:*",
    "@actview/plugin-vite": "workspace:*",
    "@actview/router": "workspace:*",
    "@actview/store": "workspace:*",
    "@actview/testing": "workspace:*",
    "@actview/devtools": "workspace:*",
    "@types/node": "^26.0.1",
    "actview": "workspace:*",
    "@babel/core": "^8.0.1",
    "happy-dom": "^20.11.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
