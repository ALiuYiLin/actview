{
  // ============================================================
  // 公共 TS 配置（根 tsconfig.json / 各包 tsconfig.json / tsconfig.test.json 共享）
  //
  // JSX 由使用 TSX 的项目显式配置（root app / core tests / jsx type-tests），
  // 统一指向 @actview/jsx 的 automatic runtime。
  //
  // 包分层（详见 docs/types-architecture.md）：
  //   @actview/core             公开类型 + DOM 渲染器 + 装饰器 + 内置组件
  //   @actview/jsx              JSX 作者层（全局 JSX 命名空间 / DOM 属性 / JSX runtime）
  //   @actview/reactivity       响应式系统（core 内部使用）
  //   @actview/shared           内部共享工具
  //   actview                   面向用户的聚合入口
  //
  // 模块解析（TypeScript project references）：
  //   - 各包 `tsconfig.json`（composite 构建）把 workspace 依赖映射到
  //     `packages/<dep>/dist-types/*.d.ts`（declaration 产物，gitignore）；
  //   - 根 `tsconfig.json` 通过 references 编排构建，应用侧同样解析到声明产物；
  //   - 各包 `tsconfig.test.json`（noEmit）把依赖映射回 `src`，让测试/类型测试
  //     在源码视角下检查。
  //   因此本文件**不再**提供全局 `paths`（避免两套解析语义漂移）。
  // ============================================================
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* JSX：由使用 TSX 的项目显式开启（root app / core tests / jsx type-tests） */

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* 第一版类组件：legacy decorators（esbuild / Babel 均可降级） */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
