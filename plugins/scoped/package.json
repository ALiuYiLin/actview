{
  "name": "@actview/plugin-scoped",
  "version": "1.0.3",
  "type": "module",
  "description": "Vue-like scoped CSS for ActView — compile-time CSS isolation (import './x.css?scoped' 自动开启)",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@actview/plugin-babel": "workspace:^",
    "@babel/core": "^8.0.1",
    "postcss": "^8.5.0",
    "postcss-selector-parser": "^7.0.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.0.1"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ]
}
