{
  "name": "@actview/plugin-babel",
  "version": "2.2.1",
  "type": "module",
  "description": "Babel 插件：JSX 组件自动 defineComponent 转换（ActView 编译核心，独立于 Vite 宿主）",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/generator": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALiuYiLin/actview.git",
    "directory": "plugins/babel"
  }
}
