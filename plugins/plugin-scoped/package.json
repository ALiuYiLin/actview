{
  "name": "@actview/plugin-scoped",
  "version": "0.2.1",
  "type": "module",
  "description": "Vue-like scoped CSS for ActView — compile-time CSS isolation (import './x.css?scoped' 自动开启)",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "postcss": "^8.5.0",
    "postcss-selector-parser": "^7.0.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/rewrite-package.mjs .",
    "release": "pnpm build && cd dist && npm publish"
  },
  "publishConfig": {
    "access": "public"
  }
}
