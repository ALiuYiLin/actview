{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm dev",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "beginsPattern": ".*VITE.*",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
