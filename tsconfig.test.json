{
  // ============================================================
  // 测试环境 TS 配置（test/v2/*.test.tsx）
  // 继承 tsconfig.base.json；JSX 类型用 actview（v2：vue 组件 +
  // React 语义属性，全局声明见 packages/actview/src/jsx-runtime.ts）
  // ============================================================
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // v2：React 语义 JSX 类型
    "jsxImportSource": "actview",
    // 测试代码类型不严谨属既有状态：关闭 strict 系与未使用检查
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["test/v2"]
}
