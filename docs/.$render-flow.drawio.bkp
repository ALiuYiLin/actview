<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="渲染流程概念图">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 组件 -->
        <mxCell id="2" value="组件&#xa;Component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- setup -->
        <mxCell id="3" value="setup()&#xa;创建响应式数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- effect 容器（渲染全流程 = 副作用） -->
        <mxCell id="4" value="effect(渲染副作用) · 渲染全流程 = Side Effect" style="swimlane;startSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="900" height="230" as="geometry" />
        </mxCell>

        <!-- 渲染管线：render → diff → patch -->
        <mxCell id="5" value="render()&#xa;生成 VNode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="4">
          <mxGeometry x="50" y="110" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="6" value="diff()&#xa;新旧 VNode 对比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="4">
          <mxGeometry x="340" y="110" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="patch()&#xa;更新真实 DOM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="4">
          <mxGeometry x="630" y="110" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- 响应式数据 -->
        <mxCell id="8" value="响应式数据&#xa;(Reactive State)&#xa;&#xa;state.xxx&#xa;&#xa;getter 拦截 · setter 拦截&#xa;dep: Set&lt;effect&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="700" width="340" height="200" as="geometry" />
        </mxCell>

        <!-- ① 首次挂载 · 依赖收集 -->
        <mxCell id="9" value="① 首次挂载 · 依赖收集&#xa;&#xa;渲染中读取 state.xxx&#xa;→ getter 拦截（读取拦截）&#xa;→ 将当前 effect 收集进 dep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="770" width="310" height="150" as="geometry" />
        </mxCell>

        <!-- ② 数据变更 · 触发更新 -->
        <mxCell id="10" value="② 数据变更 · 触发更新&#xa;&#xa;修改 state.xxx&#xa;→ setter 拦截（写入拦截）&#xa;→ 取出 dep 中所有 effect 重新执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="770" width="310" height="150" as="geometry" />
        </mxCell>

        <!-- 核心结论 -->
        <mxCell id="11" value="核心结论&#xa;&#xa;渲染全流程（生成 VNode → Diff 对比 → 更新真实 DOM）本身就是一个副作用（Side Effect）：&#xa;它依赖响应式数据作为输入，最终修改页面 DOM 产生外部影响。&#xa;把整套流程包裹进 effect，使渲染成为响应式系统可感知、可调度的依赖任务。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="1030" width="820" height="150" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="12" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1030" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="13" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="12"><mxGeometry x="10" y="30" width="30" height="16" as="geometry" /></mxCell>
        <mxCell id="14" value="组件 / 渲染流程" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="12"><mxGeometry x="50" y="28" width="130" height="20" as="geometry" /></mxCell>
        <mxCell id="15" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="12"><mxGeometry x="10" y="54" width="30" height="16" as="geometry" /></mxCell>
        <mxCell id="16" value="响应式数据" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="12"><mxGeometry x="50" y="52" width="130" height="20" as="geometry" /></mxCell>
        <mxCell id="17" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="12"><mxGeometry x="10" y="78" width="30" height="16" as="geometry" /></mxCell>
        <mxCell id="18" value="依赖收集（读取）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="12"><mxGeometry x="50" y="76" width="130" height="20" as="geometry" /></mxCell>
        <mxCell id="19" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="12"><mxGeometry x="10" y="102" width="30" height="16" as="geometry" /></mxCell>
        <mxCell id="20" value="触发更新（写入）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="12"><mxGeometry x="50" y="100" width="130" height="20" as="geometry" /></mxCell>

        <!-- 边：组件 → setup -->
        <mxCell id="30" value="执行 setup()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 边：setup → effect 容器 -->
        <mxCell id="31" value="用 effect() 包裹渲染函数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 边：render → diff（容器内） -->
        <mxCell id="32" value="生成 VNode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="4" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 边：diff → patch（容器内） -->
        <mxCell id="33" value="Diff 对比" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="4" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 边：effect 容器 → ① 依赖收集（读取路径） -->
        <mxCell id="34" value="① 渲染时读取 state.xxx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4" target="9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="265" y="530" />
              <mxPoint x="265" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 边：① 依赖收集 → 响应式数据 -->
        <mxCell id="35" value="getter 拦截 · 依赖收集&#xa;dep.add(当前 effect)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="9" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 边：响应式数据 → ② 触发更新 -->
        <mxCell id="36" value="setter 拦截 · 取出 dep 中&#xa;所有 effect 重新执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="8" target="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 边：② 触发更新 → effect 容器（回环） -->
        <mxCell id="37" value="② 重新执行 effect&#xa;重走 [render → Diff → 更新DOM]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="10" target="4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1275" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
